+def _rows(t: torch.Tensor, mask_cpu: torch.Tensor) -> torch.Tensor:
+    """t[mask_cpu] for a device tensor t and CPU bool mask, without a host<->device
+    sync. All-true (pure spec decode, the hot path) is a slice; otherwise the CPU
+    indices are copied asynchronously from pinned memory. Ported from
+    0xSero/exl3xpu vllm_patches.patch_gdn_mask_index."""
+    if t.device.type == "cpu":
+        return t[mask_cpu]
+    n = mask_cpu.shape[0]
+    if bool(mask_cpu.all()):
+        return t[:n]
+    idx = mask_cpu.nonzero().squeeze(1).pin_memory().to(t.device, non_blocking=True)
+    return t.index_select(0, idx)
