+    def update_block_table(  # type: ignore[override]
+        self,
+        metadata: GDNAttentionMetadata,
+        blk_table: torch.Tensor,
+        slot_mapping: torch.Tensor,
+    ) -> GDNAttentionMetadata:
+        """Reuse another GDN group's build for this step; only the state
+        indices (derived from this group's block table) differ. Under FULL
+        graphs every builder owns persistent buffers that its layers' captured
+        kernels read, so the shared per-step tensors are copied into this
+        builder's buffers (device-to-device, stream-ordered). Anything with
+        prefills falls back to a full build."""
+        args = metadata._gdn_build_args
+        md = metadata
+        if md.num_prefills > 0 or (md.num_spec_decodes == 0 and md.num_decodes == 0):
+            prefix, m, acc, draft_cpu, fast = args
+            m2 = replace(m, block_table_tensor=blk_table, slot_mapping=slot_mapping)
+            return self.build(prefix, m2, num_accepted_tokens=acc,
+                              num_decode_draft_tokens_cpu=draft_cpu, fast_build=fast)
+        bt = mamba_get_block_table_tensor(
+            blk_table,
+            metadata._gdn_seq_lens,
+            self.kv_cache_spec,
+            self.vllm_config.cache_config.mamba_cache_mode,
+        )
+        new = {}
+        if md.num_spec_decodes > 0:
+            n = md.num_spec_decodes
+            src = md.spec_state_indices_tensor
+            if md._gdn_bufs[0]:
+                # source is another builder's persistent buffer -> mirror into ours
+                bs = src.shape[0]
+                dst = self.spec_state_indices_tensor[:bs]
+                dst[:n].copy_(bt[:n, : self.num_spec + 1], non_blocking=True)
+                dst[n:].fill_(NULL_BLOCK_ID)
+                new["spec_state_indices_tensor"] = dst
+                for name in ("spec_sequence_masks", "spec_token_indx",
+                             "non_spec_token_indx", "spec_query_start_loc",
+                             "num_accepted_tokens"):
+                    t = getattr(md, name)
+                    buf = getattr(self, name)[: t.shape[0]]
+                    buf.copy_(t, non_blocking=True)
+                    new[name] = buf
+            else:
+                new["spec_state_indices_tensor"] = bt[:n, : self.num_spec + 1]
+        elif md.num_decodes > 0:
+            src = md.non_spec_state_indices_tensor
+            nd = md.num_decodes
+            if md._gdn_bufs[1]:
+                bs = src.shape[0]
+                dst = self.non_spec_state_indices_tensor[:bs]
+                dst[:nd].copy_(bt[:nd, 0], non_blocking=True)
+                dst[nd:].fill_(NULL_BLOCK_ID)
+                new["non_spec_state_indices_tensor"] = dst
+                t = md.non_spec_query_start_loc
+                buf = self.non_spec_query_start_loc[: t.shape[0]]
+                buf.copy_(t, non_blocking=True)
+                new["non_spec_query_start_loc"] = buf
+            else:
+                new["non_spec_state_indices_tensor"] = bt[:, 0]
+        out = replace(md, **new)
+        out._gdn_build_args = args
+        out._gdn_seq_lens = metadata._gdn_seq_lens
+        out._gdn_bufs = md._gdn_bufs
+        return out
