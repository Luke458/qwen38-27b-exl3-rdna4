+// ---------------------------------------------------------------------------
+// Kernel 4: affine correction + output Hadamard + svh + fp16 store
+// ---------------------------------------------------------------------------
+static __global__
+__launch_bounds__(G1201_THREADS)
+void g1201_out_kernel
+(
+    const float* __restrict__ accs,
+    half* __restrict__ C,              // [size_n]
+    const float* __restrict__ qrow,    // {q, s1}
