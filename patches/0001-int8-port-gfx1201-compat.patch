+// ---------------------------------------------------------------------------
+// Kernel 3: integer dot (bits=3, mul1) -- one block per 16-wide N-tile
+// ---------------------------------------------------------------------------
+__device__ __forceinline__ int g1201_dp4a(uint32_t a, uint32_t b, int c)
+{
+    // CUDA's dp4a.u32.s32 (a: unsigned bytes, b: signed bytes) -- the pairing
+    // the blueprint needs: w*M bytes unsigned, activation splat signed. Per
+    // hip_compat.hip.h: "quant/exl3_gemv_int8_kernel.cuh's dp4a.u32.s32 is
+    // exactly sudot4(false, a, true, b, c, false)". PTX inline asm does not
+    // exist on this backend (invalid instruction at device link).
+    return __builtin_amdgcn_sudot4(false, (int) a, true, (int) b, c, false);
+}
+
+template <int WARPS>
+static __global__
+__launch_bounds__(WARPS * 32)
+__attribute__((amdgpu_flat_work_group_size(WARPS * 32, WARPS * 32)))
+void g1201_dot_kernel
+(
+    const int8_t* __restrict__ A_q,
+    const uint16_t* __restrict__ B,    // trellis (K/16, N/16, 48)
+    float* __restrict__ accs,          // [size_n] fp32 warp-partial sum
+    int size_k,
+    int size_n
+)
+{
+    // One block per N-tile; the block's WARPS warps split K. Each warp owns a
+    // contiguous k16 range, accumulates 16 column partials in int32 (two
+    // columns per lane, quad-reduced), and reduces through LDS.
+    int warp_id = threadIdx.x / 32;
+    int lane = threadIdx.x % 32;
+    int tile_n = blockIdx.x;
+    int n_tiles = size_n / 16;
+    (void) n_tiles;
+
+    constexpr int bits = 3;
+    constexpr int tile_elements = 16 * bits;      // u16 per 16x16 tile
+    int num_k_tiles = size_k / 16;
+    int chunk = (num_k_tiles + WARPS - 1) / WARPS;
+    int kb0 = warp_id * chunk;
+    int kb1 = min(kb0 + chunk, num_k_tiles);
+
+    // lane mapping identical to exl3_gemv_dot_tile_direct (source-derived):
+    // lane L handles t = 8L..8L+7 -> (row, col) via t_to_rowcol
+    int r0 = (lane & 3) * 2;
+    int cA = 2 * (lane >> 3) + ((lane >> 2) & 1);
+
+    int accA = 0, accB = 0;
+    for (int k_tile = kb0; k_tile < kb1; ++k_tile)
+    {
+        const uint32_t* b_ptr = (const uint32_t*)
+            (B + ((size_t) k_tile * n_tiles + tile_n) * tile_elements);
+
+        // 8 state windows for this lane's t-range (bits=3 specialized ext8w)
+        int b1 = ((lane << 3) + 257) * bits;
+        int b0 = b1 - 16;
+        int i0 = (b0 / 32) % (bits * 8);
+        int i2 = ((b1 + bits * 7 - 1) / 32) % (bits * 8);
+        int s2 = ((b1 + bits * 7 - 1) / 32 + 1) * 32 - (b1 + bits * 7);
+        uint32_t a0 = b_ptr[i0];
+        uint32_t b0w = b_ptr[i2];
+        auto fsh = [&](int s) { return (uint32_t)(((uint64_t) a0 << 32 | b0w) >> s); };
+        uint32_t w7 = fsh(s2);
+        uint32_t w6 = w7 >> bits;
+        uint32_t w5 = w6 >> bits;
+        uint32_t w4 = w5 >> bits;
+        uint32_t w3 = fsh(s2 + bits * 4);
+        uint32_t w2 = w3 >> bits;
+        uint32_t w1 = w2 >> bits;
+        uint32_t w0 = w1 >> bits;
+        w0 &= 0xffff; w1 &= 0xffff; w2 &= 0xffff; w3 &= 0xffff;
+        w4 &= 0xffff; w5 &= 0xffff; w6 &= 0xffff; w7 &= 0xffff;
+
+        // exact mul1 state reconstruction: x = w * 0x83DCD12D (wrapping)
+        w0 *= 0x83DCD12Du; w1 *= 0x83DCD12Du; w2 *= 0x83DCD12Du; w3 *= 0x83DCD12Du;
+        w4 *= 0x83DCD12Du; w5 *= 0x83DCD12Du; w6 *= 0x83DCD12Du; w7 *= 0x83DCD12Du;
+
+        // position -> (row, col): i = 0..7 => row r0 + (i&1) + 8*((i>>1)&1),
+        // col cA + 8*(i>>2); dp4a(x, splat(i8[k])) adds i8[k] * byte_sum(x).
+        int k_base = k_tile * 16;
+        uint32_t s00 = 0x01010101u * (uint32_t)(uint8_t) A_q[k_base + r0];
+        uint32_t s01 = 0x01010101u * (uint32_t)(uint8_t) A_q[k_base + r0 + 1];
+        uint32_t s08 = 0x01010101u * (uint32_t)(uint8_t) A_q[k_base + r0 + 8];
+        uint32_t s09 = 0x01010101u * (uint32_t)(uint8_t) A_q[k_base + r0 + 9];
+
+        // NOTE on sign: A_q carries the activation sign; codebook(x) is affine
+        // in the unsigned byte sum, and dp4a.u32.s32 multiplies SIGNED bytes of
+        // the splat against UNSIGNED... -- dp4a interprets BOTH operands as
+        // signed bytes. byte_sum(w*M) is in [0, 1020] with arbitrary byte
+        // distribution; the signed-unsigned pairing is handled exactly as the
+        // upstream blueprint does (same dp4a form, same operands). Product
+        // bound for overflow remains |127| * 1020 per term.
+        accA = g1201_dp4a(w0, s00, accA);
+        accA = g1201_dp4a(w1, s01, accA);
+        accA = g1201_dp4a(w2, s08, accA);
+        accA = g1201_dp4a(w3, s09, accA);
+        accB = g1201_dp4a(w4, s00, accB);
+        accB = g1201_dp4a(w5, s01, accB);
+        accB = g1201_dp4a(w6, s08, accB);
+        accB = g1201_dp4a(w7, s09, accB);
+    }
+
+    // quad reduction: after xor hops 1,2 every lane of quad q holds the full
+    // sums for column cA = q (accA) and column q + 8 (accB)
+    accA += __shfl_xor_sync(0xffffffff, accA, 1);
+    accA += __shfl_xor_sync(0xffffffff, accA, 2);
+    accB += __shfl_xor_sync(0xffffffff, accB, 1);
+    accB += __shfl_xor_sync(0xffffffff, accB, 2);
+
+    __shared__ int sh_red[WARPS * 32];   // per warp: [8 x accA cols][8 x accB cols]
+    int* my_red = sh_red + warp_id * 32;
+    if ((lane & 3) == 0)
+    {
+        int q = lane >> 2;               // quad index == cA column
+        my_red[q] = accA;
+        my_red[16 + q] = accB;
+    }
+    __syncthreads();
+    if (warp_id == 0 && lane < 16)
+    {
+        float total = 0.0f;
+        #pragma unroll
+        for (int w = 0; w < WARPS; ++w)
+            total += (float) ((lane < 8) ? sh_red[w * 32 + lane] : sh_red[w * 32 + 16 + (lane - 8)]);
+        accs[tile_n * 16 + lane] = total;
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Kernel 4: affine correction + output Hadamard + svh + fp16 store
+// ---------------------------------------------------------------------------
+static __global__
+__launch_bounds__(G1201_THREADS)
+void g1201_out_kernel
+(
+    const float* __restrict__ accs,
+    half* __restrict__ C,              // [size_n]
+    const float* __restrict__ qrow,    // {q, s1}
+    const half* __restrict__ svh,
+    int size_n
+)
+{
+    int warp_id = (blockIdx.x * blockDim.x + threadIdx.x) / 32;
+    int lane = threadIdx.x % 32;
+    int warps = size_n / 128;
+    if (warp_id >= warps) return;
+
+    float k_inv = __half2float(__ushort_as_half(0x1eee));
+    float k_bias = __half2float(__ushort_as_half(0xc931));
+    float q = qrow[0];
+    float s1 = (float) ((const int*) qrow)[1];
+    float corr = (1024.0f * k_inv + k_bias) * (q * s1);
+
+    // per-warp 128 floats of LDS (8 warps/block max): 4 KB per block
+    extern __shared__ float sh_tmp[];
+    float* tmp = sh_tmp + (threadIdx.x / 32) * 128;
+
+    int base = warp_id * 128;
+    #pragma unroll
+    for (int i = 0; i < 4; ++i)
+    {
+        int j = lane * 4 + i;
+        tmp[j] = k_inv * (q * accs[base + j]) + corr;
+    }
+    __syncwarp();
+    had_fh_r_128_inner<false, true>(tmp, C + base, svh + base, 0.088388347648f);
+}
