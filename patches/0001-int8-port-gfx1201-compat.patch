+            g1201_quant_kernel,
+            dim3(1), dim3(G1201_THREADS), 0, s,
+            (const half*) A_had.value().data_ptr(),
+            (int8_t*) ws_aq.data_ptr(),
+            (float*) ws_q.data_ptr(),
+            size_k);
+    }
+
+    // Launch 3: integer dot (split-K by warps per block)
+    int n_tiles = size_n / 16;
+    int k_blocks = size_k / 16;
+    int warps = 8;
+    if (const char* value = std::getenv("EXL3_ROCM_GFX1201_WARPS"))
+    {
+        int requested = atoi(value);
+        if (requested == 4 || requested == 8 || requested == 16) warps = requested;
+    }
+    {
+        #define G1201_DOT(W) \
+            hipLaunchKernelGGL((g1201_dot_kernel<W>), dim3(n_tiles), dim3((W) * 32), \
+                0, s, \
+                (const int8_t*) ws_aq.data_ptr(), (const uint16_t*) B.data_ptr(), \
+                (float*) ws_acc.data_ptr(), size_k, size_n)
+        if (warps == 4) { G1201_DOT(4); }
+        else if (warps == 16) { G1201_DOT(16); }
+        else { G1201_DOT(8); }
+        #undef G1201_DOT
+    }
+
+    // Launch 4: output transform (8 warps x 128 floats of staging per block)
+    {
+        int blocks = (size_n / 128 + 7) / 8;
+        hipLaunchKernelGGL(
+            g1201_out_kernel,
+            dim3(blocks), dim3(G1201_THREADS),
+            8 * 128 * sizeof(float), s,
+            (const float*) ws_acc.data_ptr(),
+            (half*) C.data_ptr(),
+            (const float*) ws_q.data_ptr(),
+            (const half*) svh.value().data_ptr(),
+            size_n);
+    }
+
+    cuda_check(cudaPeekAtLastError());
+    g1201_trace_line("int8 staged GEMV", K, size_n);
+    return true;
 }
