+// Kernel 2: one block quantizes the complete Hadamard row after kernel 1
+// finishes on the same stream. This is the global synchronization boundary.
+static __global__
+__launch_bounds__(G1201_THREADS)
+void g1201_quant_kernel
+(
+    const half* __restrict__ A_had,
+    int8_t* __restrict__ A_q,
+    float* __restrict__ out_q,         // {q, s1} (s1 as int via reinterp)
+    int size_k
+)
+{
+    __shared__ float sh_m[33];
+
+    // Global max over the transformed row (fmax is order-independent).
+    float mx = 0.0f;
+    for (int i = threadIdx.x; i < size_k; i += G1201_THREADS)
+        mx = fmaxf(mx, fabsf(__half2float(A_had[i])));
+    #pragma unroll
+    for (int o = 16; o > 0; o >>= 1) mx = fmaxf(mx, __shfl_xor_sync(0xffffffff, mx, o));
+    if ((threadIdx.x & 31) == 0) sh_m[threadIdx.x >> 5] = mx;
+    __syncthreads();
+    if (threadIdx.x < 32)
+    {
+        float v = threadIdx.x < (G1201_THREADS >> 5) ? sh_m[threadIdx.x] : 0.0f;
+        #pragma unroll
+        for (int o = 16; o > 0; o >>= 1) v = fmaxf(v, __shfl_xor_sync(0xffffffff, v, o));
+        if (threadIdx.x == 0) sh_m[32] = fmaxf(v, 1e-8f) / 127.0f;
+    }
+    __syncthreads();
+    float q = sh_m[32];
+
+    // Quantize to int8 splats-free vector + exact int sum (blueprint math).
+    float rq = 1.0f / q;
+    int s1 = 0;
+    for (int i = threadIdx.x; i < size_k; i += G1201_THREADS)
+    {
+        float a = __half2float(A_had[i]);
+        int v = __float2int_rn(a * rq);
+        v = max(-127, min(127, v));
+        A_q[i] = (int8_t) v;
+        s1 += v;
+    }
+    #pragma unroll
+    for (int o = 16; o > 0; o >>= 1) s1 += __shfl_xor_sync(0xffffffff, s1, o);
+    if ((threadIdx.x & 31) == 0) sh_m[threadIdx.x >> 5] = __int_as_float(s1);
+    __syncthreads();
+    if (threadIdx.x < 32)
+    {
+        int v = threadIdx.x < (G1201_THREADS >> 5) ? __float_as_int(sh_m[threadIdx.x]) : 0;
+        #pragma unroll
+        for (int o = 16; o > 0; o >>= 1) v += __shfl_xor_sync(0xffffffff, v, o);
+        if (threadIdx.x == 0)
+        {
+            out_q[0] = q;
+            ((int*) out_q)[1] = v;
+        }
+    }
+}
